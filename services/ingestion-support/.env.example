# Copy to .env for local-only development and replace every placeholder.
# Never commit .env or reuse these placeholder strings in a hosted environment.
MAILBOX_CONNECTOR_SERVICE_TOKEN=<generate-a-distinct-random-token-at-least-32-characters>
PDF_TEXT_EXTRACTOR_SERVICE_TOKEN=<generate-a-second-distinct-random-token-at-least-32-characters>
MALWARE_SCANNER_SERVICE_TOKEN=<generate-a-third-distinct-random-token-at-least-32-characters>
GMAIL_OAUTH_CLIENT_ID=<google-oauth-client-id>
GMAIL_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>

# Explicit host allowlist for Host-header validation. Add the future HTTPS hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,ingestion-support

# Fixed provider origins. Hosted values must remain HTTPS.
GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1

# Bounded runtime defaults aligned with the Edge worker's maximum attachment size.
PROVIDER_TIMEOUT_SECONDS=5
REQUEST_BODY_TIMEOUT_SECONDS=10
PDF_TIMEOUT_SECONDS=10
CLAMAV_TIMEOUT_SECONDS=5
MAX_JSON_BODY_BYTES=65536
MAX_PROVIDER_RESPONSE_BYTES=1048576
MAX_ATTACHMENT_BYTES=20971519
MAX_PDF_BYTES=20971519
MAX_PDF_RESPONSE_BYTES=1048576
MAX_PDF_ROWS=5000
MAX_MAILBOX_MESSAGES=25
MAX_ATTACHMENTS_PER_MESSAGE=5
MAILBOX_TOKEN_CACHE_TTL_SECONDS=300
MAILBOX_TOKEN_CACHE_MAX_ENTRIES=256
