# Copy to a root-owned, mode 0600 .env on the approved Hosted Dev server.
# Every value below is a placeholder. Never commit the real file.
INGESTION_SUPPORT_HOSTNAME=ingestion-dev.example.invalid
ACME_EMAIL=devops@example.invalid
ALLOWED_HOSTS=ingestion-dev.example.invalid,localhost,127.0.0.1

# Generate three different random values of at least 32 characters.
MAILBOX_CONNECTOR_SERVICE_TOKEN=<distinct-host-secret-at-least-32-characters>
PDF_TEXT_EXTRACTOR_SERVICE_TOKEN=<different-host-secret-at-least-32-characters>
MALWARE_SCANNER_SERVICE_TOKEN=<third-host-secret-at-least-32-characters>

# Dev-only Google OAuth web client. Do not use a Production mailbox or app password.
GMAIL_OAUTH_CLIENT_ID=<dev-google-oauth-web-client-id>
GMAIL_OAUTH_CLIENT_SECRET=<dev-google-oauth-web-client-secret>
GMAIL_OAUTH_REDIRECT_URI=https://dev-project.example.invalid/functions/v1/cams-kfintech-ingestion/oauth/callback

# Fixed HTTPS provider origins; do not redirect these through a user-controlled URL.
GMAIL_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_OAUTH_REVOCATION_URL=https://oauth2.googleapis.com/revoke
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1

# Bounded runtime configuration.
PROVIDER_TIMEOUT_SECONDS=5
REQUEST_BODY_TIMEOUT_SECONDS=10
PDF_TIMEOUT_SECONDS=10
CLAMAV_TIMEOUT_SECONDS=5
MAX_JSON_BODY_BYTES=65536
MAX_PROVIDER_RESPONSE_BYTES=1048576
MAX_ATTACHMENT_BYTES=20971519
MAX_PDF_BYTES=20971519
MAX_PDF_RESPONSE_BYTES=1048576
MAX_PDF_ROWS=5000
MAX_MAILBOX_MESSAGES=25
MAX_MAILBOX_PAGES_PER_POLL=4
MAX_MAILBOX_CANDIDATES_PER_POLL=100
MAX_ATTACHMENTS_PER_MESSAGE=5
MAILBOX_TOKEN_CACHE_TTL_SECONDS=300
MAILBOX_TOKEN_CACHE_MAX_ENTRIES=256
