[Unit]
Description=MoneyBowl fixed-environment API release (owner installation required)
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/moneybowl-shared-deploy/host.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3.12 -I -B /opt/moneybowl-shared-deploy/launch.py
TimeoutStartSec=600
Restart=no
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/moneybowl-shared-deploy /run/moneybowl-shared-deploy
ReadOnlyPaths=/etc/moneybowl-shared-deploy /var/spool/moneybowl-shared-deploy/inbox
# No [Install] section: never boot-enabled or automatically retried.
MemoryMax=512M
TasksMax=128
