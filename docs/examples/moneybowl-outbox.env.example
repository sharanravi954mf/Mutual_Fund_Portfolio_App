# Synthetic only. Independently provision through each project's Edge settings.
# Never pass this manifest to Flutter, GitHub Actions, or the Oracle dispatcher.
MONEYBOWL_ENV=DEV
MONEYBOWL_SUPABASE_URL=https://synthetic-dev.supabase.co
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the Edge platform.
NSE_URL=https://nseinvestuat.nseindia.com
NSE_ALLOWED_READ_APIS=[]
OUTBOX_DISPATCH_MODE=disabled
OUTBOX_NOTIFICATION_KEY=REPLACE_WITH_PROJECT_LOCAL_RANDOM_SIGNING_SECRET
NSE_WORKER_TOKEN=RETAIN_PROJECT_LOCAL_WORKER_SECRET
# Vault fixed name moneybowl_outbox_notification_key holds the matching signing key.
# No NSE login/member/API credential is consumed by this dispatcher.
# QA: MONEYBOWL_ENV=QA, own project URL, NSE_URL=https://www.nseinvest.com,
#     independent secrets and OUTBOX_DISPATCH_MODE=disabled. Active is rejected.
# PROD: MONEYBOWL_ENV=PROD, own project URL, same vendor origin, disabled.
