# Synthetic manifest only. Do not source this file in a deployed project.
# Runtime Edge settings; select exactly one canonical environment.
MONEYBOWL_ENV=DEV
MONEYBOWL_SUPABASE_URL=https://synthetic-dev-project.supabase.co
NSE_URL=https://nseinvestuat.nseindia.com
NSE_CREDENTIAL_PROVIDER=edge-secrets
# DEV allows existing UAT operations; QA/PROD require an explicit JSON list.
# Start with [] (deny all). Only after approval: ["MASTER_DOWNLOAD"].
NSE_ALLOWED_READ_APIS=[]
NSE_LOGIN_USER_ID=SYNTHETIC_LOGIN_NOT_A_CREDENTIAL
NSE_API_KEY_MEMBER=SYNTHETIC_KEY_NOT_A_CREDENTIAL
NSE_API_SECRET_USER=SYNTHETIC_SECRET_NOT_A_CREDENTIAL
NSE_MEMBER_CODE=SYNTHETIC_MEMBER_NOT_A_CREDENTIAL
NSE_WORKER_TOKEN=SYNTHETIC_PROJECT_LOCAL_WORKER_TOKEN
NSE_SMOKE_TEST_TOKEN=SYNTHETIC_PROJECT_LOCAL_PROBE_TOKEN
# Optional; omit to preserve existing browser-compatible User-Agent.
NSE_USER_AGENT=MoneyBowl-Synthetic/1.0
# Supabase injects these. Do not override hosted SUPABASE_* values.
SUPABASE_URL=https://synthetic-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SYNTHETIC_BACKEND_ONLY_KEY
# Existing legacy token names, optional compatibility only:
# NSE_UCC_WORKER_TOKEN=SYNTHETIC_PROJECT_LOCAL_LEGACY_TOKEN
# NSE_UCC_RECONCILIATION_WORKER_TOKEN=SYNTHETIC_PROJECT_LOCAL_LEGACY_TOKEN
# NSE_ORDER_STATUS_WORKER_TOKEN=SYNTHETIC_PROJECT_LOCAL_LEGACY_TOKEN

# QA uses the SAME application code, independently provisioned values:
# MONEYBOWL_ENV=QA
# MONEYBOWL_SUPABASE_URL=https://synthetic-private-qa-project.supabase.co
# NSE_URL=https://www.nseinvest.com
# NSE_CREDENTIAL_PROVIDER=edge-secrets
# NSE_ALLOWED_READ_APIS=[]
# Provision QA credentials and probe token privately; NEVER copy DEV secrets.
# PROD uses MONEYBOWL_ENV=PROD, its own project binding, Production NSE origin,
# independent credentials, and explicit approvals. No Production writes in M1.

# Flutter BUILD definitions (public only; separate file/build invocation):
# MONEYBOWL_ENV=dev (legacy frontend spelling; qa for QA, prod for PROD)
# SUPABASE_URL=https://synthetic-dev-project.supabase.co
# SUPABASE_ANON_KEY=SYNTHETIC_PUBLIC_PUBLISHABLE_KEY
# AUTH_EMAIL_REDIRECT_URL=https://synthetic-dev-web.example.test
# NEVER pass this backend manifest to --dart-define-from-file.
