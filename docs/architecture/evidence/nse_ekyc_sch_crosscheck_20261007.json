  "query": "with latest as (\nselect s.id from nse_reference.snapshots s join nse_reference.validations v on v.snapshot_id=s.id\njoin nse_reference.connections c on c.id=s.connection_id join public.workspaces w on w.id=s.workspace_id\nwhere s.file_type='SCH' and v.status='STAGED_VALIDATED' and c.environment='UAT' and c.enabled and w.workspace_status='active'\norder by s.version desc,s.created_at desc,s.id desc limit 1),\nobservations as (\nselect r.*,case\nwhen r.amc_code in ('ABSL_MF','BIRLAMF_SIF','BIRLASUNLIFEMUTUALFUND_MF') then 'B'\nwhen r.amc_code in ('BANDHANMF_SIF','BANDHANMUTUALFUND_MF') then 'G'\nwhen r.amc_code in ('KOTAKMAHINDRAMF','KOTAKMF_SIF') then 'K'\nwhen r.amc_code='HDFCMUTUALFUND_MF' then 'H'\nwhen r.amc_code='CANARAROBECOMUTUALFUND_MF' then 'CR'\nwhen r.amc_code in ('HSBCMF_SIF','HSBCMUTUALFUND_MF') then 'O'\nwhen r.amc_code in ('UNIONMF_SIF','UNIONMUTUALFUND_MF') then 'UK'\nend as faq_code\nfrom nse_reference.sch_rows r join latest on latest.id=r.snapshot_id)\nselect faq_code,amc_code,count(*) as scheme_count,\narray_agg(distinct rta_agent_code order by rta_agent_code) as rta_agent_codes,\narray_agg(distinct native_fields[27] order by native_fields[27]) as amc_active_flags,\narray_agg(distinct amc_scheme_code order by amc_scheme_code) as amc_scheme_codes,\narray_agg(distinct rta_scheme_code order by rta_scheme_code) as rta_scheme_codes,\ncount(*) filter(where amc_scheme_code=faq_code) as amc_scheme_equal_faq_code_rows,\ncount(*) filter(where rta_scheme_code=faq_code) as rta_scheme_equal_faq_code_rows\nfrom observations where faq_code is not null group by faq_code,amc_code order by faq_code,amc_code;",
